# Required for Mistral (leave blank if using a different provider)
MISTRAL_API_KEY=your_actual_api_key_here

# Required for Gemini (leave blank if using a different provider)
GEMINI_API_KEY=your_gemini_api_key_here

# mistral, ollama, or gemini
MODEL_PROVIDER=mistral
MODEL_NAME=mistral-small-latest
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
TEMPERATURE=0.7
MAX_TOKENS=2048

# Used when persona.json does not exist yet
ASSISTANT_NAME=KAI
ASSISTANT_ROLE=a helpful personal AI assistant
ASSISTANT_TONE=friendly and professional
ASSISTANT_INSTRUCTIONS=

CHAT_HISTORY_FILE=chat_history.jsonl
MEMORY_FILE=memory.json
PERSONA_FILE=persona.json
WORKSPACE_DIR=workspace
MAX_HISTORY_LENGTH=100
MAX_HISTORY_TOKENS=6000
DEBUG_MODE=false
AUTO_SAVE=true
TOOLS_ENABLED=true
STREAMING=true
WEB_FETCH_MAX_CHARS=8000
MAX_TOOL_ITERATIONS=8

VOICE_WAKE_ENABLED=false
VOICE_WAKE_WORD=hey kai
