# Pick ONE provider: ollama (local, no key), gemini, or mistral
MODEL_PROVIDER=ollama
# Leave MODEL_NAME blank to use the default for the provider:
#   ollama: qwen2.5:7b   gemini: gemini-3.6-flash   mistral: mistral-small-latest
MODEL_NAME=

# Needed only for the cloud provider you choose (keep this file private)
MISTRAL_API_KEY=your_mistral_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
# How much text a local model can see at once
OLLAMA_NUM_CTX=8192

# Gemini addresses (normally leave as they are)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_BASE_URL_NATIVE=https://generativelanguage.googleapis.com/v1beta

TEMPERATURE=0.7
MAX_TOKENS=2048

# Used when persona.json does not exist yet
ASSISTANT_NAME=KAI
ASSISTANT_ROLE=a helpful personal AI assistant
ASSISTANT_TONE=friendly and professional
ASSISTANT_INSTRUCTIONS=

CHAT_HISTORY_FILE=chat_history.jsonl
MEMORY_FILE=memory.json
PERSONA_FILE=persona.json
WORKSPACE_DIR=workspace
MAX_HISTORY_LENGTH=100
MAX_HISTORY_TOKENS=12000
DEBUG_MODE=false
AUTO_SAVE=true
TOOLS_ENABLED=true
STREAMING=true
# true = plain text replies (no markdown), as the terminal shows them
PLAIN_TEXT=true

WEB_FETCH_MAX_CHARS=8000
MAX_TOOL_RESULT_CHARS=4000
MAX_TOOL_ITERATIONS=8

VOICE_WAKE_ENABLED=false
VOICE_WAKE_WORD=hey kai
